  'npm:http-signature:20150122':
    - appmetrics > tap > codecov.io > request > http-signature:
        patched: '2021-08-04T00:39:51.782Z'
  'npm:mime:20170907':
    - appmetrics > tap > codecov.io > request > form-data > mime:
        patched: '2021-08-04T00:39:51.782Z'
  'npm:request:20160119':
    - appmetrics > tap > codecov.io > request:
        patched: '2021-08-04T00:39:51.782Z'
  'npm:tunnel-agent:20170305':
    - appmetrics > tap > codecov.io > request > tunnel-agent:
        patched: '2021-08-04T00:39:51.782Z'
